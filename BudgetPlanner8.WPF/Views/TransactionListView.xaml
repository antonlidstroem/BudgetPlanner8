<UserControl x:Class="BudgetPlanner8.WPF.Views.TransactionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:BudgetPlanner8.WPF.Behaviors">

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Transaktioner"
                       Style="{StaticResource HeaderTextStyle}"
                       Margin="0,0,0,10"/>

            <!-- NY: ListView med SelectionMode="Extended" för att kunna välja flera -->
            <ListView ItemsSource="{Binding TransactionsView}"
                      SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                      SelectionMode="Extended"
                      x:Name="TransactionsList">

                <!-- NY: Behavior för att synka SelectedItems till ViewModel -->
                <i:Interaction.Behaviors>
                    <behaviors:ListViewSelectedItemsBehavior SelectedItems="{Binding SelectedTransactions}"/>
                </i:Interaction.Behaviors>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Datum" Width="90"
                                        DisplayMemberBinding="{Binding StartDate, StringFormat=d}"/>
                        <GridViewColumn Header="Slut" Width="90"
                                        DisplayMemberBinding="{Binding EndDate, StringFormat=d}"/>
                        <GridViewColumn Header="Anteckning" Width="180"
                                        DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="Kategori" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Category.Name, TargetNullValue='-'}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Återkommande" Width="100"
                                        DisplayMemberBinding="{Binding Recurrence}"/>
                        <GridViewColumn Header="Månad" Width="70"
                                        DisplayMemberBinding="{Binding Month}"/>
                        <!-- NY: Dagar kolumn -->
                        <GridViewColumn Header="Dagar" Width="60"
                                        DisplayMemberBinding="{Binding DaysCount}"/>
                        <GridViewColumn Header="%" Width="50"
                                        DisplayMemberBinding="{Binding Rate}"/>
                        <GridViewColumn Header="Brutto" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GrossAmount, StringFormat=C}"
                                               Style="{StaticResource ValueTextStyle}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Belopp" Width="85">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NetAmount, StringFormat=C}"
                                               Style="{StaticResource ValueTextStyle}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>